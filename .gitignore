# ==============================================================================
# WnR Group Website — .gitignore
# Next.js 16 (Turbopack) · React 19 · TypeScript · Tailwind CSS v4 · Vitest
# ==============================================================================

# ---- Dependencies & Package Managers -----------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ---- Next.js Core & Build Outputs --------------------------------------------
/.next/
/out/
/build/
/dist/
/.cache/

# ---- TypeScript --------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ---- Testing & Coverage (Vitest / Testing Library) ---------------------------
/coverage/
/.nyc_output/
test-results/
vitest.config.ts.timestamp-*
vite.config.ts.timestamp-*

# ---- Environment Variables & Secrets -----------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt

# ---- Logs & Traces -----------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
trace-turbopack*
.turbopack-trace*

# ---- AI Agent, Skill & IDE Tooling / Scratch Workspace -----------------------
/.agents/
/.claude/
/.gemini/
/.superpowers/
/scratch/
/skills-lock.json
.cursor/
.cursorrules

# ---- Editor & IDE Configuration ----------------------------------------------
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ---- OS Files & Metadata (Windows / macOS / Linux) ---------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# macOS / Linux
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---- Cloud Providers & Deployment Tools --------------------------------------
.vercel/
.netlify/
